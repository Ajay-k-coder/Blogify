<%- include("../layouts/boilerplate") %> 
<div class="otp-ms">
  <h2>Verify Your Email</h2>
    <p>Sent to: <strong><%= email %></strong></p>
</div>

<div class="otp-container">
  
  <form action="/user/auth/otp" method="POST">
    <input type="hidden" name="email" value="<%= email %>">
    <input type="text" name="otp[1]" maxlength="1" required>
    <input type="text" name="otp[2]" maxlength="1" required>
    <input type="text" name="otp[3]" maxlength="1" required>
    <input type="text" name="otp[4]" maxlength="1" required>
    <input type="text" name="otp[5]" maxlength="1" required>
    <input type="text" name="otp[6]" maxlength="1" required>
    <button type="submit">Verify OTP</button>
  </form>
</div>