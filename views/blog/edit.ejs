<%- include("../layouts/boilerplate") %>
<body class="container">
    <div class="form-container">
    
        <form action="/blog/edit/<%= blog._id %>" method="POST" enctype="multipart/form-data" class="container" >

            <div class="mt-3 d-flex">
                <input type="text" class="form-control" id="title" name="title" value="<%= blog.title %>" placeholder="Title..." required>
            </div>
            
            <div class="change-image-container">
                <img src="<%= blog.path %>" alt="blog image" id="edit-blog-image" class="edit-blog-image mb-3 mt-3">
                <input class="form-control image-input" type="file" id="image-input"  name="image"   accept="image/*" style="max-width:800px;"> 

            </div>
 
             <div class="form-group">
                <label for="tags">Tags</label>
                <input
                    type="text"
                    id="tags"
                    name="tags"
                    placeholder="e.g., Node.js, Backend, Tutorial"
                    class="form-control"
                    style="margin-bottom: 0px"
                />
                <small style="color: #ffffff">Separate tags with commas.</small>
            </div>

                        <div class="write-form-container">
                <label for="content" class="form-label">Content</label>
               
            <div class="editor-wrap mb-3 mt-4" style=" min-height:40vh; background-color: #e6e6e6; color: white; border-radius: 8px; border: 1px solid #475569; margin-bottom: 20px;">
                    <div class="quill-contianer "  id="quill-contianer" style="min-height: 400px !important; font-size: 16px; border: none; color:black">
                       <%- blog.content %>
                    </div>
            </div>
            <!-- </div> -->
            <input type="hidden" id="hidden-content" name="content">
                 <div class="preview-btn-div ">
            <button type="submit" class="preview-btn btn btn-outline-light px-4 py-2" id="submit-button">Preview</button>
            </div>
        </form>
    </div>
</body>
 