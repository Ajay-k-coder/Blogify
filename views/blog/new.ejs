<%- include("../layouts/boilerplate") %>
<body class="container">
    <div class="form-container">
        <form
            action="/blog/"
            method="POST"
            enctype="multipart/form-data"
            class="container"
        >
            <div class="mb-3 mt-3">
                <input
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                    placeholder="Title..."
                    required
                />
            </div>

            <div class="change-image-container">
                <label
                    for="image-input"
                    style="margin-left: 30px; font-weight: 900"
                    class="form-label"
                >
                    Image
                </label>
                <img
                    src=""
                    alt="blog image"
                    id="edit-blog-image"
                    class="edit-blog-image mb-3 mt-3 class_none"
                />

                <input
                    class="form-control image-input"
                    type="file"
                    id="image-input"
                    name="image"
                    accept="image/*"
                    style="max-width: 800px"
                />
            </div>
            <div class="form-group">
                <label for="tags">Tags</label>
                <input
                    type="text"
                    id="tags"
                    name="tags"
                    placeholder="e.g., Node.js, Backend, Tutorial"
                    class="form-control"
                    style="margin-bottom: 0px"
                />
                <small style="color: #ffffff">Separate tags with commas.</small>
            </div>

            <div class="write-form-container">
                <label for="content" class="form-label">Content</label>
                <div class="editor-wrap mb-3 mt-2">
                    <div class="quill-contianer" id="quill-contianer"></div>
                </div>
            </div>
            <input type="hidden" id="hidden-content" name="content" />
            <div class="preview-btn-div">
                <button
                    type="submit"
                    class="preview-btn btn btn-outline-light px-4 py-2"
                    id="submit-button"
                >
                    Preview
                </button>
            </div>
        </form>
    </div>
</body>
