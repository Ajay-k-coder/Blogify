<%- include("../layouts/boilerplate") %>

<body class="container" id="preview-page-bg">
    <div class="blog-field">
       
        <!-- <div class="image"> -->
  
            <!-- <%= blog.path %> -->
        <!-- </div> -->
         <div class="title">
            <h1><%= blog.title %></h1>
            <img src="<%= blog.path %>"></a>
        </div> 
         <hr>
