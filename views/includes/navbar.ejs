
<body class="container">
<nav  class="navbar sticky-top mt-1 navbar-expand" >
  <div class="container">
  
    <a class="logo_container" href="/home">
   
         <!-- <img src="\images\logo_canva_copy.svg" style="color:white" class="logo_image" alt="blogify_logo" > -->
         <span style="font-weight:900; font-size:20px;" >Blogify</span>

     </a>
      <div class="searchbox searchbox-inside-navbar">
    
        <form action="/home" method="GET" >
              <input type="text" name="search" placeholder="Enter Author name or Blog title..." class="searchbox_input">
              <button type="submit" class="searchbox_button">seach</button>
        </form>
      </div>

    <div class="navbar-nav   text-white">
      <a class="nav-link  text-white" href="/home">Home</a>
       <a class="nav-link text-white" href="/blog/new">Write</a>
      <% if (locals.user) { %>

         <a class="nav-link " href="/profile/<%=user.id%>">
                    <img src="<%= user.profile_image_url %>" width="35" height="35" class="rounded-circle ms-2">
          </a>
        
      <% } else { %> 
        <a class="nav-link  text-white" href="/user/login">Login</a>
        <a class="nav-link text-white get-start" href="/user/signup">signup</a>
      <% } %>
    </div>
  </div>

 
 <div class="searchbox searchbox-outside-navbar">   
        <form action="/home" method="GET">
              <input type="text" name="search" placeholder="Enter Author name or Blog title... " class="searchbox_input form-control"><button type="submit" class="searchbox_button">seach</button>
        </form>
      </div>
</nav>

<% if (locals.error) { %>
  <div class="alert alert-danger" role="alert">
    <%- error %>
   </div>
<% } %>
 
</body>
 