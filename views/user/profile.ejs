<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4 text-center">
            <img src="<%= profileUser.profile_image_url.replace(/\\/g, '/') %>" 
                 class="rounded-circle shadow mb-3" style="width: 150px; height: 150px; object-fit: cover;">
            <h2><%= profileUser.full_name %></h2>
            <p class="text-muted"><%= profileUser.bio || 'No bio added yet.' %></p>
            
            <% if (isOwnProfile) { %>
                <a href="/user/edit-profile" class="btn btn-outline-primary btn-sm">Edit Profile</a>
            <% } else { %>
                <button class="btn btn-primary btn-sm">Follow</button>
            <% } %>
            <hr>
            <small class="text-muted">Member since <%= new Date(profileUser.created_at).toLocaleDateString() %></small>
        </div>

        <div class="col-md-8">
            <h4 class="mb-4">Published Posts (<%= userBlogs.length %>)</h4>
            <% if (userBlogs.length > 0) { %>
                <div class="row">
                    <% userBlogs.forEach(blog => { %>
                        <div class="col-md-12 mb-3">
                            <div class="card shadow-sm h-100 flex-row overflow-hidden">
                                <img src="<%= blog.path.replace(/\\/g, '/') %>" style="width: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title"><%= blog.title %></h5>
                                    <p class="card-text text-truncate" style="max-width: 400px;"><%= blog.body %></p>
                                    <a href="/blog/<%= blog._id %>" class="btn btn-link p-0">Read More</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="text-center text-muted mt-5">This user hasn't posted anything yet.</p>
            <% } %>
        </div>
    </div>
</div>