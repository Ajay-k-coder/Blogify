<%- include("../layouts/boilerplate") %>


<body class="container">
    <div class="container mt-5 profile-body ">
        <div class="row justify-content-center">
            <div class="col-md-4 text-center user_info">
                <img src="<%= profileUser.profile_image_url.replace(/\\/g, '/') %>" 
                    class="rounded-circle shadow mb-3"  >
                <div class="user-details">
                    <div class="name-bio">
 
                        <div class="name">
                             
                            <h3 style="color:white;" class="user_name"><%= profileUser.full_name %></h3>
                          
                        </div>
                    
                          
                        <div class="bio">
                           <p style="font-size:14px;"><%= profileUser.bio || 'No bio added yet.' %></p>
                        </div>
                        </div>
 
                        <div class="stats">
                            <li><%= userBlogs.length %> <small>Blogs</small></li>
                            <li><%= profileUser.followerCount %>  <small>Followers</small></li>
                            <li><%= profileUser.followingCount %> <small>Following</small></li>
                        </div>
                        
        
                    <% if (isOwnProfile) { %>

                        <a href="/profile/edit/" class="btn btn-outline-primary btn-sm " >Edit Profile</a>
                    <% } else { %>
                          
                        <form action="/profile/<%= profileUser.id %>/follow" method="POST" class="d-inline">
                            <button type="submit" class="<%= profileUser.isFollowing ? 'unfollow' : 'follow' %> ">
                                <%= profileUser.isFollowing ? 'following' : 'Follow' %>
                            </button>
                        </form>
                    <% } %>
                </div>
                <hr>
                  <div class="joined">
                 </div>
            </div>

            <div class="col-md-8 user_blogs">  
                <div class="options">
                    <button   class="public active  user_options "> Published</button>
                    <% if ( isOwnProfile) { %>
                        <button id="like" class="like user_options"> Like</button>
                        <button id="save" class="save user_options"> Save</button>

                    <% } %>
                </div>
                <div class="save_post class_none"></div>
                <div class="like_post class_none"> asldkfjalskdf a sdlfja sf alsdfj </div>
                <div class="published_post class_block">
                    <% if (userBlogs.length > 0) { %>
                        <div class="row ppost user-blogs-list">
                            <% userBlogs.forEach(blog => { %>

                            <a href="/blog/<%= blog._id %>" class="home-card-anchor">   
                                <div class="parent blog">
                                    <div class="child1 grid-child">
                                        <img
                                            src="<%= blog.path %>"
                                            alt="image"
                                            class="home_card_image"
                                        />
                                    </div>
                                    <div class="child2 grid-child name-and-date ">   &nbsp; by: <%= blog.author %></div>
                                    <div class="child3 grid-child name-and-date ">   <%= blog.createdAt %></div>
                                    <div class="child4 grid-child">
                                        <h1 class="title"><%= blog.title %></h1>
                                    </div>
                                    <div class="child5 grid-child">
                                        <p><%=striptags( blog.content).substring(0,80) %>...</p> 

                                    </div>
                                </div>
                    
                        </a>
                            <% }) %>
                
                    <% } else { %>
                        <p class="text-center text-muted mt-5">This user hasn't posted anything yet.</p>
                    <% } %>
                </div>
            </div>
            </div>
        </div>
    </div>
</body>